<?xml version="1.0" encoding="utf-8"?>
<!-- أندرويد ١٢ وما بعده: لا تُنسخ بيانات سكينة إلى السحابة ولا تُنقل تلقائياً بين الأجهزة.
     بيانات المستخدم على جهازه فقط، ونقلها يكون بالنسخة الاحتياطية من الإعدادات باختياره. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
